# =============================================================================
# Soul Society Monorepo .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
*.local
.turbo/

# Rust
/target/
**/*.rs.bk
Cargo.lock

# WASM
crates/soul-wasm/pkg/

# Cairo
crates/soul-cairo/target/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI context (reference only)
.ai/

# Testing
coverage/
.nyc_output/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Misc
*.pem
*.key
.cache/
tmp/
