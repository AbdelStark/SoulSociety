{
  "name": "soul-society",
  "private": true,
  "version": "0.1.0",
  "description": "A permissionless marketplace for verifiable digital services using Nostr and STARKs",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm -F @soul-society/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build:wasm": "./scripts/build-wasm.sh",
    "setup": "./scripts/setup.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
