{
  "name": "soul-society",
  "private": true,
  "version": "0.1.0",
  "description": "Sovereign verifiable computation over Nostr, Cairo, and STWO",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm -F @soul-society/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build:wasm": "./scripts/build-wasm.sh",
    "setup": "./scripts/setup.sh",
    "check": "./scripts/check.sh",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  }
}
