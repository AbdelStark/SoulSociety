# Soul Society Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Nostr Configuration
# =============================================================================

# Local relay for development
NOSTR_RELAY_URL=ws://localhost:8080

# Production relays (comma-separated)
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol

# =============================================================================
# Provider Configuration
# =============================================================================

# Provider secret key (hex-encoded 32 bytes)
# Generate with: openssl rand -hex 32
PROVIDER_SECRET_KEY=

# Second provider key (for multi-provider setup)
PROVIDER_SECRET_KEY_2=

# Provider identity
PROVIDER_NAME=soul-provider-1
PROVIDER_DESCRIPTION="Soul Society DVM Provider"

# =============================================================================
# Web Configuration
# =============================================================================

# Relay URL for web frontend
VITE_NOSTR_RELAY_URL=ws://localhost:8080

# Enable mock mode for development (bypasses real Nostr)
VITE_ENABLE_MOCK_MODE=true

# =============================================================================
# Logging
# =============================================================================

# Rust log level
RUST_LOG=info,soul_provider=debug,soul_core=debug

# Log format (json or pretty)
LOG_FORMAT=pretty

# =============================================================================
# Feature Flags
# =============================================================================

# Enable Lightning Network payments (future feature)
ENABLE_LIGHTNING_PAYMENTS=false

# Enable multi-provider mode
ENABLE_MULTI_PROVIDER=false
